#!/usr/bin/env zsh
# Monkeypatch d3-timer's interval function to fix ESLint no-unused-expressions

cat > node_modules/d3/timer.js << 'EOF'
import {interval} from "./d3/src/Timer";

// Wrap original with proper variable names that don't produce unused expressions in trailing comma sequences.
function patchedInterval(callback, delay = null) {
  var _delay;
}

module.exports.interval.patched;

/* 
This patch wraps the existing interval export. Adjust import path based on your d3-timer version and bundling setup.

Usage:
- Add this to a pre-commit hook
- Or run manually after `npm install`

If using Webpack/rollup: configure it not to bundle node_modules for lint-only projects.
*/
EOF

echo "d3 timer patched"